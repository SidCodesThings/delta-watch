{
  "//": "Hides the folders that are downloaded or generated, so the file list shows our own work.",
  "files.exclude": {
    "node_modules": true,
    "dist": true,
    "package-lock.json": true,
    ".oxlintrc.json": true,
    ".claude": true,
    ".vscode": true
  },
  "explorer.sortOrder": "type",
  "workbench.editor.enablePreview": false,
  "editor.minimap.enabled": false
}
